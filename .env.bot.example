# Never commit filled secrets. Existing .env cloud account keys do not replace a bot token or DB URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
ENGINE_SECRET=
DATABASE_URL=
BOT_RUN_DIR=output/top10-yfinance-latest-2026-10-12/core
BOT_PRICES=output/top10-yfinance-latest-2026-10-12/prices.csv
BOT_ARTIFACTS=output/bot-artifacts
BOT_ALLOW_LIVE=false
# Local previews/polling do not schedule refreshes. Cloud Worker enables this.
BOT_AUTO_REFRESH=false
BOT_FINANCIAL_SNAPSHOTS=output/yfinance-all-2026-10-12/raw
BOT_FX_SNAPSHOT=output/yfinance-all-2026-10-12/USDIDR.json
BOT_LATEST_POINTER=output/daily-refresh/latest.json
# Cloud container only: https://<worker>.workers.dev/internal/bundle
INPUT_BUNDLE_URL=
