# Never commit filled secrets. Existing .env cloud account keys do not replace a bot token or DB URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
# Anyone in these explicitly listed groups can command the bot.
TELEGRAM_OPEN_GROUP_IDS=
TELEGRAM_WEBHOOK_SECRET=
ENGINE_SECRET=
DATABASE_URL=
BOT_RUN_DIR=output/top10-yfinance-latest-2026-10-12/core
BOT_PRICES=output/top10-yfinance-latest-2026-10-12/prices.csv
BOT_ARTIFACTS=output/bot-artifacts
BOT_ALLOW_LIVE=false
# Local previews/polling do not schedule refreshes. Cloud Worker enables this.
BOT_AUTO_REFRESH=false
BOT_FINANCIAL_SNAPSHOTS=output/yfinance-all-2026-10-12/raw
BOT_FX_SNAPSHOT=output/yfinance-all-2026-10-12/USDIDR.json
BOT_LATEST_POINTER=output/daily-refresh/latest.json
# Cloud container only: https://<worker>.workers.dev/internal/bundle
INPUT_BUNDLE_URL=
# Optional agentic runtime. Set an explicit OpenRouter model supporting tool calling.
BOT_AGENT_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TOKENS=8192
AGENT_TIMEOUT_SECONDS=300
# Empty/default preserves provider default; false disables reasoning for compatible models.
AGENT_REASONING_ENABLED=
BOT_IDX_ENABLED=false
BOT_IDX_CACHE=output/idx-cache
